# StaySmartGuest environment variables
# Read at build time by Expo (any var starting with EXPO_PUBLIC_ is exposed to the app).

# Your computer's LAN IP (from `ipconfig`) — phone must be on the same Wi-Fi.
EXPO_PUBLIC_API_BASE=http://192.168.0.119:8000/api/v1

