# --- Environment ---
ENV=development
DEBUG=true

# DEMO_MODE=true uses seeded city data, cached providers and
# deterministic fallbacks. DEMO_MODE=false uses live integrations.
DEMO_MODE=true

# --- Database ---
# SQLite (offline demo):  DATABASE_URL=sqlite:///./smrtresort360.db
# PostgreSQL (production): DATABASE_URL=postgresql+psycopg://staysmart:staysmart@localhost:5432/smrtresort360
DATABASE_URL=sqlite:///./smrtresort360.db

# --- Authentication ---
# REQUIRED in production (anything but a random 32+ char string is a demo default)
JWT_SECRET=demo-insecure-change-me-0123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Demo seed credentials (demo-only, documented in DEMO.md)
DEMO_GUEST_PASSWORD=DemoGuest!2026
DEMO_STAFF_PASSWORD=DemoStaff!2026
DEMO_MANAGER_PASSWORD=DemoManager!2026

# Demo seed identities (created on first boot; see SEEDING in docs)
DEMO_GUEST_EMAIL=guest@smartresort360.demo
ADMIN_EMAIL=admin@smartresort360.demo
MANAGER_EMAIL=manager@smartresort360.demo
HOTEL_NAME=Smart Resort 360 Grand Jaipur

# --- Seeding ---
SEED_ON_STARTUP=true
# Path to the curated Jaipur POI catalogue (optional; inferred from repo layout when empty).
SEED_DATA_FILE=

# --- CORS (JSON array) ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://127.0.0.1:5173","http://127.0.0.1:5174"]

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=240

# --- External integrations (leave blank in DEMO_MODE) ---
LLM_PROVIDER=local            # local | openai_compatible | anthropic
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
OSRM_URL=                     # e.g. https://router.project-osrm.org
OPENWEATHER_API_KEY=
GOOGLE_PLACES_API_KEY=